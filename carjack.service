[Unit]
Description=carjack - wireless CarPlay bridge
# Only user units are orderable from here; NetworkManager, bluetooth and the network targets
# belong to the system manager. carjack retries its whole flow on failure, so that costs a
# retry at worst.
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
# Resolved under $XDG_STATE_HOME/$XDG_CACHE_HOME; src/paths.rs reads the variables, not the paths.
StateDirectory=carjack
CacheDirectory=carjack
ExecStart=/usr/bin/carjack

# WiFi goes through NetworkManager's D-Bus API, which polkit gates (carjack-polkit.rules), not a
# group. What the account does need - audio/video/render for a seatless session - is a property
# of the account: user units have no SupplementaryGroups=.
NoNewPrivileges=yes

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
