[Unit]
Description=carjack - wireless CarPlay bridge
After=network.target bluetooth.target NetworkManager.service iwd.service carjack-hci-helper.service
Wants=bluetooth.target NetworkManager.service iwd.service carjack-hci-helper.service

[Service]
Type=simple
DynamicUser=yes
User=carjack
StateDirectory=carjack
Environment=HOME=/var/lib/carjack
ExecStart=/usr/local/bin/carjack

AmbientCapabilities=CAP_DAC_OVERRIDE CAP_CHOWN
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN
NoNewPrivileges=yes

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
