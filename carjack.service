[Unit]
Description=carjack - wireless CarPlay bridge
# Only user units can be ordered against from here; iwd/bluetooth/network belong to the system
# manager. Costs nothing - carjack retries its whole flow on failure.
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
# Still $STATE_DIRECTORY/$CACHE_DIRECTORY, now under $XDG_STATE_HOME/$XDG_CACHE_HOME. src/paths.rs
# reads the variables, so it works unchanged in either kind of unit.
StateDirectory=carjack
CacheDirectory=carjack
ExecStart=/usr/bin/carjack

# DynamicUser=/CapabilityBoundingSet=/ProtectSystem= are gone with the move out of the system
# manager, and little of it was doing work: DynamicUser= declines to allocate when a static user of
# that name exists, which here it does. The iwd grant survives - it was always the iwd-provision
# group, now a property of the account (user units have no SupplementaryGroups=). That account also
# needs netdev, since iwd's D-Bus policy denies net.connman.iwd to everyone else.
NoNewPrivileges=yes

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
