[Unit]
Description=carjack - wireless CarPlay bridge
# Only user units are orderable from here; iwd, bluetooth and the network targets belong to the
# system manager. carjack retries its whole flow on failure, so that costs a retry at worst.
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
# Resolved under $XDG_STATE_HOME/$XDG_CACHE_HOME; src/paths.rs reads the variables, not the paths.
StateDirectory=carjack
CacheDirectory=carjack
ExecStart=/usr/bin/carjack

# The account this runs as must be in iwd-provision, for the profile write into /var/lib/iwd
# (src/wifi_connect/iwd.rs), and in netdev, which is what iwd's D-Bus policy checks. User units
# have no SupplementaryGroups=, so both are properties of the account.
NoNewPrivileges=yes

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
