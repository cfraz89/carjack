// A lingering session is classed `background` and never active, so NetworkManager's WiFi actions
// (src/wifi_connect/networkmanager.rs) miss `allow_active` and fall to `allow_any` - auth_admin,
// with nobody at a console to answer it. Grant them to this one user instead.
//
// settings.modify.system, not just .own: the accessory profile carries no `connection.permissions`,
// so NetworkManager treats AddAndActivateConnection - and the Update and Delete in
// accessory_connection() - as a change to a system connection. That action is auth_admin_keep in
// every case, active or not, so without this the connect fails with "Insufficient privileges".
polkit.addRule(function (action, subject) {
    if (
        subject.user == "carjack" &&
        (action.id == "org.freedesktop.NetworkManager.network-control" ||
            action.id == "org.freedesktop.NetworkManager.settings.modify.own" ||
            action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
            action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
            // The setup AP is a WPA2 `ipv4.method=shared` connection, which NetworkManager gates
            // on its own action rather than on settings.modify - see src/wifi_connect/setup_ap.rs.
            action.id == "org.freedesktop.NetworkManager.wifi.share.protected")
    ) {
        return polkit.Result.YES;
    }
});
