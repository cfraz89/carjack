board := "radxa-dragon-q6a"
branch := "edge"
kernel_git := "full"
build_minimal := "yes"
release := "trixie"
ufs := "false"
sector_size := if ufs == "true" { "4096" } else { "512" }
kernel_configure := "no"
platform := "linux/amd64"

# Run armbian's compile command
[arg('command', pattern='|kernel|kernel-config|kernel-patch|dts-check|kernel-dtb')]
compile command="": chown-build-volumes mount-build-fs build-container clean-output (run-armbian-build "./compile.sh" \
    "BOARD=" + board\
    "BRANCH=" + branch\
    "KERNEL_GIT=" + kernel_git\
    "BUILD_MINIMAL=" + build_minimal\
    "RELEASE=" + release\
    "SECTOR_SIZE=" + sector_size\
    "KERNEL_CONFIGURE=" + kernel_configure\
    command )

[private]
run-armbian-build *args:
    podman run --platform {{platform}} --rm -it \
        -v ~/.gitconfig:/armbian/.gitconfig:z \
        -v ./output:/armbian/output:z \
        -v ./cache:/armbian/cache:z \
        -v ./tmp/:/armbian/.tmp:z \
        -v /proc/sys/fs/binfmt_misc:/proc/sys/fs/binfmt_misc:ro \
        localhost/armbian-build-carjack {{args}}

[private]
clean-output:
    rm -rf output/*

# Launch a shell in the armbian build container
build-container-shell: chown-build-volumes mount-build-fs build-container (run-armbian-build "/bin/bash")
[private]
[script]
mount-build-fs:
    uid=`id -u`
    gid=`id -g`
    tmpdir="$PWD"/tmp
    sudo mount -t tmpfs -o size=12G,mode=0777,uid="$uid",gid="$gid" tmpfs "$tmpdir"
    sudo mount binfmt_misc -t binfmt_misc /proc/sys/fs/binfmt_misc

[private]
chown-build-volumes:
    sudo --preserve-env chown -R $USER:$USER output
    sudo --preserve-env chown -R $USER:$USER cache
    sudo --preserve-env chown -R $USER:$USER tmp

# Remove build directories
clean: chown-build-volumes clean-output
    rm -rf cache/*
    rm -rf tmp/*

[private]
setup-build-dirs:
    mkdir -p output
    mkdir -p cache
    mkdir -p tmp

[private]
build-container: fetch-build
    podman build -t armbian-build-carjack --platform {{platform}} .

[private]
[script]
fetch-build:
    if [ -d "./build" ]; then
        echo "Updating armbian build system"
        cd build && git pull
    else
        echo "Cloning armbian build system"
        git clone git@github.com:cfraz89/armbian-build.git build
    fi

# Rsync built kernel to fishball and install
install-kernel-on-fishball:
    rsync -ravzP --delete output/debs fishball:~
    ssh root@fishball "dpkg -i /home/fishball/debs/*.deb"
