board := "radxa-dragon-q6a"
config := "carjack"
ufs := "yes"
ufs_sector_size_switch := if ufs == "yes" { "SECTOR_SIZE=4096" } else { "" }

# Run armbian's compile command
[arg('command', pattern='|kernel|kernel-config|kernel-patch|dts-check|kernel-dtb')]
compile command="": (run-armbian-build "./compile.sh " + "BOARD=" + board + " " + ufs_sector_size_switch + " " + config + " " + command)

[private]
run-armbian-build *args: build-container mount-binfmt-misc
    sudo podman run \
        --rm -it \
        --privileged \
        -v ~/.gitconfig:/armbian/.gitconfig:z \
        -v ./output:/armbian/output:z \
        -v ./cache:/armbian/cache:z \
        -v /proc/sys/fs/binfmt_misc:/proc/sys/fs/binfmt_misc:ro \
        -v /dev:/dev \
        --device /dev/loop-control \
        --device-cgroup-rule='b 7:* rmw' \
        localhost/armbian-build-carjack {{ args }}

[private]
clean-output:
    sudo rm -rf output/*

# Launch a shell in the armbian build container
build-container-shell: (run-armbian-build "/bin/bash")

[private]
[script]
mount-binfmt-misc:
    if ! mountpoint -q /proc/sys/fs/binfmt_misc; then
        echo "Mounting binfmt_misc filesystem"
        sudo mount binfmt_misc -t binfmt_misc /proc/sys/fs/binfmt_misc
    fi

# Remove build directories
clean: clean-output
    sudo rm -rf cache/*

[private]
setup-build-dirs:
    mkdir -p output
    mkdir -p cache

[private]
build-container: fetch-build
    sudo podman build -t armbian-build-carjack .

[private]
[script]
fetch-build:
    if [ -d "./build" ]; then
        echo "Updating armbian build system"
        cd build && git pull
    else
        echo "Cloning armbian build system"
        git clone git@github.com:armbian/build.git build
    fi

# Rsync built kernel to fishball and install
install-kernel-on-fishball:
    rsync -ravzP --delete output/debs fishball:~
    ssh root@fishball "dpkg -i /home/fishball/debs/*.deb"
