From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Fraser <cfraz89@gmail.com>
Date: Sun, 17 May 2026 10:03:52 +0000
Subject: Set usb port for carplay with dual role and no 5V output

Signed-off-by: Christopher Fraser <cfraz89@gmail.com>
---
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts | 46 ++++++++++
 1 file changed, 46 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index bb5a42b038f1..b8598f13b3de 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -1091,5 +1091,51 @@ &sdc2_cmd {
 
 &sdc2_data {
 	bias-pull-up;
 	drive-strength = <10>;
 };
+
+/ {
+	/* Carplay-specific configuration for the dual-role usb-a connector */
+	usb_carplay_connector: carplay-connector {
+		compatible = "usb-c-connector";
+		label = "USB-A Physical on USB-C controller, configured for carplay";
+
+		data-role = "dual";
+		power-role = "sink";
+		typec-power-opmode = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				carplay_hs_in: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs>;
+				};
+			};
+		};
+	};
+};
+
+
+&usb_1 {
+	dr_mode = "peripheral";
+	usb-role-switch;
+	status = "okay";
+	hnp-disable;
+	srp-disable;
+	adp-disable;
+	snps,dis_enblslpm_quirk;
+	snps,dis_u2_susphy_quirk;
+	snps,dis_u3_susphy_quirk;
+	/* Ensure we don't supply power over 5V even when in host mode */
+	/delete-property/ vbus-supply;
+	/* Mask the power rails so host data engine runs as power sink */
+	qcom,vbus-valid-override;
+	qcom,vbus-override-value = <1>;
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&carplay_hs_in>;
+};
