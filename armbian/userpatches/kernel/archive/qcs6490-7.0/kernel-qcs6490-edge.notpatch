From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Mon, 18 May 2026 11:41:13 +0000
Subject: Patching kernel qcs6490 files
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts | 13 ++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index 0ae090161245..bdaf459dce16 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -310,10 +310,18 @@ vph_pwr: regulator-vph-pwr {
 		regulator-max-microvolt = <3700000>;
 
 		regulator-boot-on;
 		regulator-always-on;
 	};
+
+	dummy_vbus: dummy-vbus-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "dummy-vbus";
+		regulator-min-microvolts = <5000000>;
+		regulator-max-microvolts = <5000000>;
+		always-on;
+	};
 };
 
 &apps_rsc {
 	regulators-0 {
 		compatible = "qcom,pm7325-rpmh-regulators";
@@ -1047,13 +1055,14 @@ &ufs_mem_phy {
 
 	status = "okay";
 };
 
 &usb_1 {
-	dr_mode = "host";
-
+	dr_mode = "otg";
 	status = "okay";
+	usb-role-switch;
+	vbus-supply = <&dummy_vbus>;
 };
 
 &usb_1_dwc3_hs {
 	remote-endpoint = <&usb3_con_hs_in>;
 };
-- 
Created with Armbian build tools https://github.com/armbian/build

