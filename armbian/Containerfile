FROM ghcr.io/armbian/docker-armbian-build:armbian-ubuntu-resolute-latest
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y python3-setuptools sudo qemu-user-binfmt binfmt-support
RUN echo "ubuntu ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
RUN rm -rf /armbian
COPY --chown=ubuntu:ubuntu build /armbian
WORKDIR /armbian
COPY userpatches userpatches

ENV ALLOW_ROOT=yes
ENV PREFER_DOCKER=no
# ENV FORCE_USE_RAMDISK=no
# ENV USE_TMPFS=no
