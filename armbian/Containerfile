FROM ghcr.io/armbian/docker-armbian-build:armbian-ubuntu-resolute-latest
RUN rm -rf /armbian
RUN git clone https://github.com/cfraz89/armbian-build /armbian
WORKDIR /armbian
COPY userpatches userpatches

#The dragon dts isn't in the shallow checkout
ENV ALLOW_ROOT=yes
ENV USE_TMPFS=no
ENV PREFER_DOCKER=no
