// Motopod in motopod's image: the APK Gradle builds and signs with the image's platform key
// (gradle/motopod/build.gradle.kts), staged beside this file by motopod's `just carjack`.

android_app_import {
    name: "Motopod",
    apk: "Motopod.apk",
    // Installed as signed: its dex and JNI are already uncompressed and aligned.
    preprocessed: true,
    system_ext_specific: true,
}
