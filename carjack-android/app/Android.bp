// The Android app over the carjack core, in two builds from one source tree:
//  - Carjack: platform-signed and preinstalled (motopod), so it gets its permissions and hidden
//    APIs without anyone at the screen. src-platform/.
//  - Slipstream: an ordinary app for any phone running Shizuku, on the public SDK.
//    src-generic/.
// libcarjack_android.so comes from `just android` in the carjack repo, staged beside this file.

cc_prebuilt_library_shared {
    name: "libcarjack_android",
    compile_multilib: "64",
    arch: {
        arm64: {
            srcs: ["lib/arm64/libcarjack_android.so"],
        },
    },
    shared_libs: ["liblog"],
    strip: {
        none: true,
    },
    // An NDK variant too, for the generic app.
    sdk_version: "30",
    stl: "none",
    system_ext_specific: true,
}

android_app {
    name: "Carjack",
    srcs: [
        "src/**/*.java",
        "src-platform/**/*.java",
    ],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    jni_libs: ["libcarjack_android"],
    use_embedded_native_libs: true,
    optimize: {
        // JNI calls back into Native.Callbacks by name.
        enabled: false,
    },
}

// Shizuku's client (Apache-2.0), 13.1.5 from Maven Central, for the generic build's display mode.
android_library_import {
    name: "carjack-shizuku-api",
    aars: ["libs/shizuku/api.aar"],
    sdk_version: "current",
    static_libs: [
        "carjack-shizuku-aidl",
        "carjack-shizuku-shared",
        "androidx.annotation_annotation",
    ],
}

android_library_import {
    name: "carjack-shizuku-aidl",
    aars: ["libs/shizuku/aidl.aar"],
    sdk_version: "current",
}

android_library_import {
    name: "carjack-shizuku-shared",
    aars: ["libs/shizuku/shared.aar"],
    sdk_version: "current",
}

android_library_import {
    name: "carjack-shizuku-provider",
    aars: ["libs/shizuku/provider.aar"],
    sdk_version: "current",
    static_libs: ["carjack-shizuku-api"],
}

// The home screen the generic build gives the head unit's display, from carjack-yocto's launcher.
android_library {
    name: "carjack-launcher",
    srcs: ["launcher/src/**/*.kt"],
    resource_dirs: ["launcher/res"],
    manifest: "launcher/AndroidManifest.xml",
    sdk_version: "current",
    // OnBackInvokedCallback, which HomeActivity holds.
    min_sdk_version: "33",
}

android_app {
    name: "Slipstream",
    srcs: [
        "src/**/*.java",
        "src-generic/**/*.java",
        "src-generic/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["src-generic"],
    },
    static_libs: [
        "carjack-shizuku-provider",
        "carjack-launcher",
    ],
    manifest: "generic/AndroidManifest.xml",
    resource_dirs: ["generic/res"],
    sdk_version: "current",
    min_sdk_version: "33",
    jni_libs: ["libcarjack_android"],
    use_embedded_native_libs: true,
    optimize: {
        enabled: false,
    },
}
