<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon, adaptive: the launcher cuts its own shape from the full layers, rather than
     shrinking a finished picture into a circle of its own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/sl_icon_background" />
    <foreground android:drawable="@drawable/ic_sl_launcher_foreground" />
</adaptive-icon>
