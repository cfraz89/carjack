<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault for Material You's widgets and type, recoloured to carjack's palette. -->
    <style name="CarjackApp" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/cj_surface</item>
        <item name="android:colorBackground">@color/cj_surface</item>
        <item name="android:colorPrimary">@color/cj_primary</item>
        <item name="android:colorAccent">@color/cj_primary</item>
        <item name="android:colorControlActivated">@color/cj_primary</item>
        <item name="android:textColorPrimary">@color/cj_on_surface</item>
        <item name="android:textColorSecondary">@color/cj_on_surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/CarjackApp.Dialog</item>
    </style>

    <!-- Dark in values-night. -->
    <style name="CarjackApp.Dialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/cj_primary</item>
        <item name="android:colorControlActivated">@color/cj_primary</item>
        <item name="android:colorBackground">@color/cj_surface_container_high</item>
    </style>
</resources>
