<?xml version="1.0" encoding="utf-8"?>
<!-- The generic build: an ordinary app for any phone running Shizuku. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android Auto runs with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- What the wallpaper service asks of an app reading the phone's wallpaper. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Roughly where the phone is, for the weather. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The mobile data network's type, for the system bar. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- The apps the head unit can be given, for the picker and the launcher; and the home app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Android Auto, for the start screen's hint where it's missing. -->
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:name=".SlipstreamApplication"
        android:label="Slipstream"
        android:theme="@style/SlipstreamApp"
        android:icon="@mipmap/ic_sl_launcher"
        android:roundIcon="@mipmap/ic_sl_launcher"
        android:extractNativeLibs="false">

        <activity
            android:name=".SettingsActivity"
            android:exported="true" />
        <activity
            android:name=".OnConnectActivity"
            android:exported="false" />
        <activity
            android:name=".AppPickerActivity"
            android:exported="false" />
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@style/SlipstreamTheme" />
        <!-- The app's own screen: waiting for the head unit, then the remote once a session is up,
             brought forward when one starts. A task of its own, gone from recents once closed:
             closing it at the session's end goes back to whatever was showing before. -->
        <activity
            android:name=".PhoneRemoteActivity"
            android:exported="true"
            android:theme="@style/SlipstreamTheme"
            android:launchMode="singleTask"
            android:taskAffinity=".remote"
            android:autoRemoveFromRecents="true"
            android:screenOrientation="sensor"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The launcher (launcher/), which Slipstream opens on the head unit's display by
             component: not a home app on the phone. Shown when locked: the head unit's display sits
             in the phone's display group, which the lock screen otherwise blacks out. -->
        <activity
            android:name="io.github.cfraz89.slipstream.launcher.HomeActivity"
            android:exported="true"
            android:theme="@style/SlipstreamTheme.Home"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.cfraz89.slipstream.launcher"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:showWhenLocked="true"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode" />
        <!-- The launcher keeps a task of its own (taskAffinity): sharing the app's, the app's
             icon would bring the launcher forward rather than the app. -->
        <activity
            android:name="io.github.cfraz89.slipstream.launcher.AllAppsActivity"
            android:exported="false"
            android:theme="@style/SlipstreamTheme.Panel"
            android:launchMode="singleTop" />
        <!-- singleTop, both: taps queued up behind a lagging stream open one, not a stack. -->
        <activity
            android:name="io.github.cfraz89.slipstream.launcher.SettingsActivity"
            android:exported="false"
            android:theme="@style/SlipstreamTheme.Panel.Full"
            android:launchMode="singleTop" />

        <service
            android:name=".SlipstreamService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The mode switched from Quick Settings. -->
        <service
            android:name=".SlipstreamTile"
            android:exported="true"
            android:label="Slipstream"
            android:icon="@drawable/ic_sl_notify"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Lets the launcher see what other apps are playing; enabled through Shizuku. -->
        <service
            android:name="io.github.cfraz89.slipstream.launcher.MediaListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Log bundles, readable only by the app each is shared with. -->
        <provider
            android:name=".LogsProvider"
            android:authorities="io.github.cfraz89.slipstream.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Shizuku's handshake: how its server hands Slipstream a binder. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="io.github.cfraz89.slipstream.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- Sentry, for crash reports: started by Reports, with the DSN in res/values/sentry.xml,
             so the switch can stop it. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            tools:node="remove" />
    </application>
</manifest>
