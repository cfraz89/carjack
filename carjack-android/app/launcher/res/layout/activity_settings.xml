<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/settings_root"
    android:orientation="vertical"
    android:background="@drawable/panel_window"
    android:fitsSystemWindows="true">

    <!-- A Material 3 small top app bar: navigation icon, then the title. Taller than the
         spec's 64dp, like everything else here, for gloves. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/top_app_bar_side_padding"
        android:paddingEnd="@dimen/grid_padding">

        <ImageView
            android:id="@+id/settings_back"
            android:layout_width="@dimen/top_app_bar_nav_size"
            android:layout_height="@dimen/top_app_bar_nav_size"
            android:padding="@dimen/icon_button_padding"
            android:src="@drawable/arrow_back_24"
            android:scaleType="fitCenter"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/top_app_bar_title_gap"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/screen_title_size"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/grid_padding"
            android:paddingEnd="@dimen/grid_padding"
            android:paddingBottom="@dimen/grid_padding">

            <LinearLayout
                android:id="@+id/setting_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/setting_row_gap"
                android:minHeight="@dimen/stepper_button_size"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/setting_row_padding"
                android:paddingEnd="@dimen/setting_row_padding"
                android:paddingTop="@dimen/shortcut_padding"
                android:paddingBottom="@dimen/shortcut_padding"
                android:background="@drawable/card_background"
                android:foreground="@drawable/ripple_transparent"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_wallpaper"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/setting_label_size" />

                <TextView
                    android:id="@+id/setting_wallpaper_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/app_label_size" />
            </LinearLayout>

            <include
                android:id="@+id/setting_columns"
                layout="@layout/row_stepper" />

            <include
                android:id="@+id/setting_rows"
                layout="@layout/row_stepper" />

            <include
                android:id="@+id/setting_recents"
                layout="@layout/row_stepper" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
