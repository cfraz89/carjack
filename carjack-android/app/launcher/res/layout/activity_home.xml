<?xml version="1.0" encoding="utf-8"?>
<!-- Everything sits straight on the wallpaper, a soft fade at top and bottom keeping it legible
     without boxes behind each part. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The wallpaper is drawn here rather than by windowShowWallpaper: the panels' blur (Blur)
         is cut from a copy of what this view shows. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrim_top_height"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrim_bottom_height"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Time and date; the weather where the phone is (the unit shows no air temperature)
             and the phone's battery. -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/status_padding"
            android:paddingEnd="@dimen/status_padding"
            android:paddingTop="@dimen/status_padding_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- One line, scaled to fit rather than wrapped. -->
                <TextClock
                    style="@style/HudText.Big"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/status_clock_height"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="@dimen/status_clock_min"
                    android:autoSizeMaxTextSize="@dimen/status_clock_max"
                    android:gravity="start|center_vertical" />

                <TextClock
                    style="@style/HudText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:format12Hour="EEEE d MMMM"
                    android:format24Hour="EEEE d MMMM" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:id="@+id/status_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/status_clock_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/status_weather_icon"
                        android:layout_width="@dimen/status_icon_size"
                        android:layout_height="@dimen/status_icon_size"
                        android:layout_marginEnd="@dimen/status_icon_gap"
                        android:tint="@color/accent"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/status_temperature"
                        style="@style/HudText.Big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/status_temperature_size" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_detail"
                    style="@style/HudText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- What's playing, from whichever app: shown only while there is something. -->
        <LinearLayout
            android:id="@+id/playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/status_padding"
            android:paddingEnd="@dimen/playing_padding_end"
            android:paddingTop="@dimen/playing_padding_top"
            android:visibility="gone">

            <ImageView
                android:id="@+id/playing_art"
                android:layout_width="@dimen/playing_art_size"
                android:layout_height="@dimen/playing_art_size"
                android:scaleType="centerCrop"
                android:background="@drawable/card_background"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/playing_text_gap"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playing_title"
                    style="@style/HudText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textFontWeight="600"
                    android:textSize="@dimen/playing_title_size" />

                <TextView
                    android:id="@+id/playing_artist"
                    style="@style/HudText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/playing_previous"
                style="@style/PlayingButton"
                android:src="@drawable/ic_skip_previous"
                android:contentDescription="@string/playing_previous" />

            <ImageView
                android:id="@+id/playing_toggle"
                style="@style/PlayingButton"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/playing_toggle" />

            <ImageView
                android:id="@+id/playing_next"
                style="@style/PlayingButton"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="@string/playing_next" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/shortcut_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/grid_padding"
            android:useDefaultMargins="false" />

        <io.github.cfraz89.slipstream.launcher.TaskbarView
            android:id="@+id/taskbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/taskbar_height"
            android:layout_marginStart="@dimen/taskbar_margin"
            android:layout_marginEnd="@dimen/taskbar_margin"
            android:layout_marginBottom="@dimen/taskbar_margin" />
    </LinearLayout>
</FrameLayout>
