<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The wallpaper is drawn here rather than by windowShowWallpaper: a backdrop blur only sees
         this window's own surface, and a wallpaper behind the window is not part of it. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Time, date, the weather where the phone is (the unit shows no air temperature),
             and the phone's battery. Blurred like the taskbar. -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/taskbar_margin"
            android:layout_marginEnd="@dimen/taskbar_margin"
            android:layout_marginTop="@dimen/taskbar_margin"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/status_padding"
            android:paddingEnd="@dimen/status_padding"
            android:paddingTop="@dimen/status_padding_vertical"
            android:paddingBottom="@dimen/status_padding_vertical"
            android:background="@drawable/status_background">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/status_clock_size" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/status_line_gap"
                    android:format12Hour="EEEE d MMMM"
                    android:format24Hour="EEEE d MMMM"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/status_detail_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/status_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/status_clock_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/status_line_gap"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/status_detail_size" />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:id="@+id/shortcut_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/grid_padding"
            android:useDefaultMargins="false" />

        <!-- Floating rather than edge to edge, so the blur has wallpaper on every side. -->
        <io.github.cfraz89.slipstream.launcher.TaskbarView
            android:id="@+id/taskbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/taskbar_height"
            android:layout_marginStart="@dimen/taskbar_margin"
            android:layout_marginEnd="@dimen/taskbar_margin"
            android:layout_marginBottom="@dimen/taskbar_margin"
            android:background="@drawable/taskbar_background" />
    </LinearLayout>
</FrameLayout>
