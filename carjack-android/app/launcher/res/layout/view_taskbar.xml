<?xml version="1.0" encoding="utf-8"?>
<!-- merge: TaskbarView is itself the horizontal LinearLayout these sit in. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/taskbar_all_apps"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/taskbar_button_size"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/taskbar_side_padding"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/taskbar_button_padding"
        android:paddingEnd="@dimen/taskbar_button_padding"
        android:background="@drawable/ripple_transparent"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:layout_width="@dimen/taskbar_apps_icon_size"
            android:layout_height="@dimen/taskbar_apps_icon_size"
            android:src="@drawable/ic_apps"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/HudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/taskbar_button_label_gap"
            android:text="@string/apps"
            android:textFontWeight="600"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textSize="@dimen/taskbar_button_label_size" />
    </LinearLayout>

    <View
        android:id="@+id/taskbar_divider"
        android:layout_width="@dimen/divider_width"
        android:layout_height="@dimen/divider_height"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/divider_margin"
        android:layout_marginEnd="@dimen/divider_margin"
        android:background="@drawable/divider" />

    <LinearLayout
        android:id="@+id/taskbar_recents"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical|start" />

    <!-- Icon only: the gear reads on its own, and the label was eating taskbar width. -->
    <ImageView
        android:id="@+id/taskbar_settings"
        android:layout_width="@dimen/taskbar_button_size"
        android:layout_height="@dimen/taskbar_button_size"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/taskbar_side_padding"
        android:padding="@dimen/icon_button_padding"
        android:src="@drawable/settings_24"
        android:scaleType="fitCenter"
        android:background="@drawable/ripple_circle"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:clickable="true" />
</merge>
