<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/shortcut_padding"
    android:focusable="true"
    android:clickable="true"
    android:stateListAnimator="@animator/press">

    <!-- Weighted, so the label keeps its line and the icon gives up the space on a short cell. -->
    <ImageView
        android:id="@+id/shortcut_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxHeight="@dimen/shortcut_icon_size"
        android:minHeight="@dimen/shortcut_icon_min"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/shortcut_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shortcut_label_top"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        style="@style/HudText"
        android:textFontWeight="500"
        android:letterSpacing="0.04"
        android:textSize="@dimen/shortcut_label_size" />
</LinearLayout>
