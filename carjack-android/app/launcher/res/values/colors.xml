<?xml version="1.0" encoding="utf-8"?>
<!-- Material You: every colour comes from the system palette Monet derives from the wallpaper, taken
     from its dark tones so the UI stays dark whatever the system is set to. The translucent ones
     are in res/color, since only a colour state list can put an alpha on a system colour. -->
<resources>
    <color name="background">@android:color/system_neutral1_900</color>
    <color name="text_primary">@android:color/system_neutral1_50</color>
    <color name="text_secondary">@android:color/system_neutral2_200</color>
    <color name="accent">@android:color/system_accent1_200</color>
    <color name="on_accent">@android:color/system_accent1_800</color>
    <color name="tonal">@android:color/system_accent2_700</color>
    <color name="on_tonal">@android:color/system_accent2_100</color>
</resources>
