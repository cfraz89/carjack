# The Android apps' Gradle build: JDK, Android SDK and NDK, and Rust with cargo-ndk for the native
# core. Used by the Justfile's `_gradle`; the repo and caches are bind-mounted.
FROM docker.io/library/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless curl ca-certificates unzip git build-essential cmake perl \
        pkg-config python3 \
    && rm -rf /var/lib/apt/lists/*

ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p $ANDROID_HOME/cmdline-tools \
    && curl -fsSL -o /tmp/tools.zip \
        https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip \
    && unzip -q /tmp/tools.zip -d $ANDROID_HOME/cmdline-tools \
    && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
    && rm /tmp/tools.zip \
    && yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null \
    && $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager \
        "platforms;android-36.1" "build-tools;36.0.0" "platform-tools" "ndk;29.0.14206865" >/dev/null \
    && chmod -R a+rX $ANDROID_HOME
ENV ANDROID_NDK_HOME=$ANDROID_HOME/ndk/29.0.14206865

ENV GRADLE_VERSION=9.9.1
RUN curl -fsSL -o /tmp/gradle.zip \
        https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip \
    && unzip -q /tmp/gradle.zip -d /opt && rm /tmp/gradle.zip \
    && ln -s /opt/gradle-$GRADLE_VERSION/bin/gradle /usr/local/bin/gradle

# Toolchains under /opt, read-only to the build; CARGO_HOME (the registry) is a volume at run time.
ENV RUSTUP_HOME=/opt/rustup
RUN curl -fsSL https://sh.rustup.rs | CARGO_HOME=/opt/cargo sh -s -- -y --profile minimal \
        --target aarch64-linux-android --no-modify-path \
    && CARGO_HOME=/opt/cargo /opt/cargo/bin/cargo install cargo-ndk --version 4.1.2 --locked \
    && mv /opt/cargo/bin/cargo-ndk /usr/local/bin/ \
    && chmod -R a+rX /opt/rustup /opt/cargo
ENV PATH=/opt/cargo/bin:$PATH
