source = "app"

[bluetooth]
#   device = "auto"                # whichever CarPlay unit is in range, strongest signal first
#   device = "AA:BB:CC:DD:EE:FF"   # by MAC
#   device = "MYCAR-1234"          # by advertised name
# "auto" scans for units hosting the iAP accessory service and takes the strongest, so it picks the
# unit in this car over one parked next door. The unit that last ran a session through to AirPlay
# wins outright when it is in range, which also skips the scan window.
device = "auto"

[portal]
# The config portal, and the setup access point it is reached on. Off means carjack runs on this
# file alone - worth setting on a board that is configured and installed, since anyone who reaches
# the portal can change the head unit and the WiFi network.
# The AP ships on the password "carjack1"; the portal makes you change it before it does anything
# else, and the new one is kept in the state dir, not here.
enabled = true

# Which adapter does what, on a board with two. Either an interface name or a MAC.
# Left unset, CarPlay takes the adapter the board came with - one that cannot be unplugged, and
# off-bus ahead of USB - and the uplink takes what is left, so a plug-in dongle becomes the uplink
# without being named here. Worth naming both on a board whose own radio is a USB part.
# [wifi]
# carplay = "wlp1s0"
# uplink = "wlx00c0ca123456"

[graphics]
#   "auto"
#   "nvidia" / "amdgpu" / "i915" - pick by driver
#   "/dev/dri/renderD129"   - an explicit render-node path
#   "0" / "1" / ...         - a numeric index (0 -> renderD128, 1 -> renderD129)
drm_device = "auto"

# Zero-copy encode 
#   "auto"   - try zero-copy; if it can't be set up, fall back to software (with a warning)
#   true     - require zero-copy; error out at startup if it can't be set up
#   false    - software encode only
zerocopy = "auto"

# Where ARGB becomes the NV12 a hardware encoder wants. Only consulted on the encode path that
# needs that conversion done here - Qualcomm, which has no V4L2 converter element to do it -
# since elsewhere there is nothing to move.
#   "auto"   - convert on the display controller's writeback block, falling back to the GPU with
#              a warning if it is unavailable
#   true     - require the display controller; error out at startup if it can't be set up
#   false    - convert on the GPU, through the shader pass in src/nv12.rs
# The hardware path frees the GPU of the conversion entirely, but it holds DRM master for the
# device while carjack runs, so nothing else can modeset. Off by default until it has more hours
# on it.
writeback = false

# Which codec the screen stream carries:
#   "auto"   - HEVC if the accessory declares it (`hevcInfo` or the multi-codec feature bit),
#              otherwise H264
#   "hevc"   - HEVC whatever the accessory declares. An iPhone sends HEVC to units that declare
#              nothing, so this is worth trying on one that shows black
#   "h264"   - H264 always
# A unit that declares no HEVC may still decode it - or may show a black screen while accepting
# every frame without complaint, which is what the bench unit does. Falls back to H264 if the
# machine has no HEVC encoder installed.
codec = "auto"

# Target video bitrate in kbit/s 
bitrate = 3000   # 3 Mbit/s ceiling

[display]
# Initial compositor size/rate, used before the accessory reports its real display over AirPlay.
# TIP: set these to your accessory's actual values. Then the app boots at the right size and the later
# reconfigure is a no-op - important with resizable = false below.
width = 1280
height = 720
fps = 30

[app]
# Stock Waydroid boots on the 3-button nav bar, which eats the bottom of the accessory's screen
# and leaves the edge swipes nothing to hit - turn on gesture nav under Settings > System >
# Gestures. carjack's own images (waydroid-build) are built with it as the default.
command = "waydroid show-full-ui"
# Can the app live-resize?
#   true  - launched at startup and resize itself when we detect accessory size
#   false - can't resize NOT launched until the accessory's resolution is known,
#           and relaunched on later reconnects that change the size
resizable = false

# A background process `command` needs running. Started before it and stopped after it, so the
# helper's lifetime is carjack's rather than the app child's. All optional; omit `start` for none.
[app.service]
start = "waydroid session start"
# Polled until it exits 0 before `command` runs.
ready = "waydroid status | grep -q 'Session:.*RUNNING'"
# Graceful stop, tried before `start` is signalled.
stop = "waydroid session stop"
