source = "app"

[bluetooth]
#   device = "AA:BB:CC:DD:EE:FF"   # by MAC
#   device = "MYCAR-1234"          # by advertised name
device = "MYCAR-1234"

[graphics]
#   "auto"
#   "nvidia" / "amdgpu" / "i915" - pick by driver
#   "/dev/dri/renderD129"   - an explicit render-node path
#   "0" / "1" / ...         - a numeric index (0 -> renderD128, 1 -> renderD129)
drm_device = "auto"

# Zero-copy encode 
#   "auto"   - try zero-copy; if it can't be set up, fall back to software (with a warning)
#   true     - require zero-copy; error out at startup if it can't be set up
#   false    - software encode only
zerocopy = "auto"

# Which codec the screen stream carries:
#   "auto"   - HEVC if the accessory declares it (`hevcInfo` or the multi-codec feature bit),
#              otherwise H264
#   "hevc"   - HEVC whatever the accessory declares. An iPhone sends HEVC to units that declare
#              nothing, so this is worth trying on one that shows black
#   "h264"   - H264 always
# A unit that declares no HEVC may still decode it - or may show a black screen while accepting
# every frame without complaint, which is what the bench unit does. Falls back to H264 if the
# machine has no HEVC encoder installed.
codec = "auto"

# Target video bitrate in kbit/s 
bitrate = 3000   # 3 Mbit/s ceiling

[display]
# Initial compositor size/rate, used before the accessory reports its real display over AirPlay.
# TIP: set these to your accessory's actual values. Then the app boots at the right size and the later
# reconfigure is a no-op - important with resizable = false below.
width = 1280
height = 720
fps = 30

[app]
command = "waydroid show-full-ui"
# Can the app live-resize?
#   true  - launched at startup and resize itself when we detect accessory size
#   false - can't resize NOT launched until the accessory's resolution is known,
#           and relaunched on later reconnects that change the size
resizable = false
