// carjack runs in a lingering session, which logind classes as `background` and never marks
// active. NetworkManager's polkit actions for adding/activating/scanning WiFi connections (see
// src/wifi_connect.rs) therefore miss `allow_active` and fall to `allow_any`, which is auth_admin -
// blocked, with nobody at a console to answer the prompt. Grant them to this one user instead.
// Installed by the deb and by `just install-carjack-service`.
polkit.addRule(function (action, subject) {
    if (
        subject.user == "carjack" &&
        (action.id == "org.freedesktop.NetworkManager.network-control" ||
            action.id == "org.freedesktop.NetworkManager.settings.modify.own" ||
            action.id == "org.freedesktop.NetworkManager.wifi.scan")
    ) {
        return polkit.Result.YES;
    }
});
