[Unit]
Description=carjack HCI helper - sets the Bluetooth adapter's Class of Device
After=bluetooth.target
Wants=bluetooth.target
Before=carjack.service

[Service]
Type=oneshot
ExecStart=/usr/bin/carjack-hci-helper

# The one thing this needs elevated: setting the Bluetooth adapter's Class of Device over a raw
# HCI mgmt socket (see src/bin/carjack-hci-helper.rs). Kept out of carjack.service entirely so the
# main process never carries the capability.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
